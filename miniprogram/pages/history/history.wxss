.history {
  min-height: 100vh;
  padding: 40rpx 40rpx 60rpx;
}

.seg {
  display: flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid var(--line);
}

.seg--sub {
  margin-top: 18rpx;
  padding: 0;
  background: transparent;
  border-color: transparent;
}

.seg-item {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}

.seg--sub .seg-item {
  height: 60rpx;
  margin: 0 8rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid var(--line);
}

.seg--sub .seg-item:first-child {
  margin-left: 0;
}

.seg--sub .seg-item:last-child {
  margin-right: 0;
}

.seg-item--on {
  background: #ffffff;
  color: var(--ink);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(74, 58, 32, 0.08);
}

.seg--sub .seg-item--on {
  background: var(--primary-soft);
  border-color: var(--primary);
  color: var(--primary);
  box-shadow: none;
}

.range {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 0 24rpx;
}

.range-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.7);
  color: var(--ink-2);
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.range-btn--off {
  opacity: 0.3;
}

.range-label {
  font-size: 30rpx;
  font-weight: 600;
}

.chart {
  padding: 28rpx 24rpx 22rpx;
}

.chart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
  padding: 0 6rpx;
}

.chart-title {
  font-size: 26rpx;
  font-weight: 600;
}

.chart-legend {
  display: flex;
  align-items: center;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
}

.dot--done {
  background: var(--done);
}

.dot--undone {
  background: var(--undone);
}

.chart-body {
  display: flex;
}

.y-axis {
  width: 56rpx;
  height: 200rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  padding-right: 12rpx;
  font-size: 20rpx;
  color: #aab2ac;
}

.plot-scroll {
  flex: 1;
  min-width: 0;
}

.plot {
  position: relative;
  height: 272rpx;
}

.plot--week {
  width: 100%;
}

.grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  z-index: 0;
}

.grid-line {
  height: 1rpx;
  background: #efe9dd;
}

.cols {
  position: relative;
  z-index: 1;
  display: flex;
  height: 100%;
}

.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.plot--month .col {
  flex: none;
  width: 46rpx;
}

.bar-wrap {
  width: 100%;
  height: 200rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar {
  width: 22rpx;
  display: flex;
  flex-direction: column;
  border-radius: 8rpx 8rpx 3rpx 3rpx;
  overflow: hidden;
}

.plot--month .bar {
  width: 18rpx;
}

.bar-undone {
  width: 100%;
  background: var(--undone);
}

.bar-done {
  width: 100%;
  background: var(--done);
}

.bar-none {
  width: 22rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #eae3d5;
}

.plot--month .bar-none {
  width: 18rpx;
}

.col-date {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: var(--ink-3);
  white-space: nowrap;
}

.col-week {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: #b8bfb9;
  white-space: nowrap;
}

.col--today {
  color: var(--primary);
  font-weight: 700;
}

.chart-empty {
  margin-top: 14rpx;
  padding: 12rpx 0 4rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
}

.summary {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  padding: 30rpx 0;
}

.sum-item {
  flex: 1;
  text-align: center;
}

.sum-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
}

.sum-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.sum-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--line);
}
