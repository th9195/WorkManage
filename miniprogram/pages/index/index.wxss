.home {
  min-height: 100vh;
  padding: 72rpx 40rpx 60rpx;
  position: relative;
  overflow: hidden;
}

.glow {
  position: absolute;
  top: -240rpx;
  right: -160rpx;
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(221, 106, 52, 0.16) 0%, rgba(221, 106, 52, 0) 70%);
}

.hero {
  position: relative;
  margin-bottom: 56rpx;
}

.hero-mark {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--ink);
}

.hero-slogan {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: var(--ink-2);
  letter-spacing: 2rpx;
}

.hero-date {
  margin-top: 28rpx;
  display: inline-block;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid var(--line);
  font-size: 22rpx;
  color: var(--ink-3);
}

.entries {
  position: relative;
}

.entry {
  position: relative;
  padding: 36rpx 34rpx;
  border-radius: 32rpx;
  border: 1rpx solid var(--line);
  margin-bottom: 26rpx;
  box-shadow: 0 12rpx 32rpx rgba(74, 58, 32, 0.06);
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.entry--adult {
  background: linear-gradient(140deg, #fffdf8 0%, #fbeade 100%);
}

.entry--kid {
  background: linear-gradient(140deg, #fffdf8 0%, #fbf0d9 100%);
}

.entry--hover {
  transform: scale(0.985);
  box-shadow: 0 6rpx 18rpx rgba(74, 58, 32, 0.08);
}

.entry-head {
  display: flex;
  align-items: center;
}

.entry-emoji {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  background: rgba(255, 255, 255, 0.85);
  margin-right: 20rpx;
}

.entry-title {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.entry-desc {
  margin-top: 22rpx;
  font-size: 25rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

.entry-foot {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.entry-stat {
  font-size: 24rpx;
  color: var(--ink-3);
}

.entry-go {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--sunrise);
}

.entry--kid .entry-go {
  color: var(--kid);
}

.home-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: center;
}

.home-link {
  padding: 18rpx 44rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.6);
  font-size: 26rpx;
  color: var(--ink-2);
}

.home-link--hover {
  background: rgba(255, 255, 255, 0.95);
}

.home-foot {
  margin-top: 80rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bcc2bc;
  letter-spacing: 4rpx;
}
