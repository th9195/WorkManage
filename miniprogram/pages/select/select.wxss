.select-page {
  min-height: 100vh;
  padding: 48rpx 40rpx 0;
}

.page-kicker {
  font-size: 24rpx;
  color: var(--ink-2);
  letter-spacing: 2rpx;
}

.page-title {
  margin-top: 12rpx;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.page-date {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.picked {
  margin-top: 36rpx;
  padding: 28rpx;
  background: linear-gradient(140deg, #ffffff 0%, #eef5f1 100%);
}

.picked-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.picked-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
}

.picked-hint {
  font-size: 22rpx;
  color: var(--ink-3);
}

.group {
  margin-top: 44rpx;
}

.group-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
}

.group-title::before {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--sunrise);
  margin-right: 12rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chips--top {
  margin-top: 22rpx;
}

.chip {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  font-size: 26rpx;
  color: var(--ink);
  transition: background 0.12s ease, border-color 0.12s ease;
}

.chip--on {
  background: var(--primary-soft);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 600;
}

.chip-emoji {
  margin-right: 8rpx;
}

.chip-x {
  margin-left: 12rpx;
  font-size: 26rpx;
  opacity: 0.7;
}

.custom-row {
  display: flex;
  align-items: center;
}

.custom-input {
  flex: 1;
  height: 88rpx;
  padding: 0 26rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  font-size: 27rpx;
  color: var(--ink);
}

.custom-placeholder {
  color: #b3bab4;
}

.custom-add {
  margin-left: 16rpx;
  width: 140rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-add--off {
  opacity: 0.4;
}

.custom-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.bottom-space {
  height: 190rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(246, 242, 233, 0.96);
  border-top: 1rpx solid var(--line);
}

.footer-inner {
  display: flex;
  align-items: center;
}

.footer-inner .ghost-btn {
  width: 200rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.footer-inner .primary-btn {
  flex: 1;
  min-width: 0;
}
